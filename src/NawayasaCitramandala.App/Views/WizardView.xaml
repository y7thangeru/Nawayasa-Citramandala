<UserControl x:Class="NawayasaCitramandala.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NawayasaCitramandala.Localization"
             xmlns:controls="clr-namespace:NawayasaCitramandala.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:NawayasaCitramandala.ViewModels"
             xmlns:views="clr-namespace:NawayasaCitramandala.Views"
             xmlns:core="clr-namespace:NawayasaCitramandala.Core;assembly=NawayasaCitramandala.Core">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:ScalePercentToFactorConverter x:Key="ScalePercentToFactorConverter" />
        <views:MmToPixelConverter x:Key="MmToPixelConverter" />
    </UserControl.Resources>

    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel MaxWidth="1120" Margin="{StaticResource PagePadding}">
            <!-- Wizard Header Title -->
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,6"
                        Command="{Binding ReturnHomeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="House" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Home" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Disc Burning Wizard" Style="{StaticResource H1Title}" />
                    <TextBlock Text="Easy 4-step workflow: Load Audio/Image → Position Layout → Finalize &amp; Burn → Save Design"
                               Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- 4-Step Breadcrumb Bar -->
            <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Tab -->
                    <Button Grid.Column="0" Style="{StaticResource TileButton}" Padding="8,10"
                            Command="{Binding GoToStepCommand}" CommandParameter="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource Surface2Brush}" Margin="0,0,8,0">
                                <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Text="1. Load Audio &amp; Image" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Step 2 Tab -->
                    <Button Grid.Column="1" Style="{StaticResource TileButton}" Padding="8,10"
                            Command="{Binding GoToStepCommand}" CommandParameter="2"
                            IsEnabled="{Binding HasImage}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource Surface2Brush}" Margin="0,0,8,0">
                                <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Text="2. Position Layout" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Step 3 Tab -->
                    <Button Grid.Column="2" Style="{StaticResource TileButton}" Padding="8,10"
                            Command="{Binding GoToStepCommand}" CommandParameter="3"
                            IsEnabled="{Binding HasImage}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource Surface2Brush}" Margin="0,0,8,0">
                                <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Text="3. Finalize &amp; Burn" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Step 4 Tab -->
                    <Button Grid.Column="3" Style="{StaticResource TileButton}" Padding="8,10"
                            Command="{Binding GoToStepCommand}" CommandParameter="4"
                            IsEnabled="{Binding HasImage}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{DynamicResource Surface2Brush}" Margin="0,0,8,0">
                                <TextBlock Text="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Text="4. Save Design" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ====================================================================== -->
            <!-- STEP 1: LOAD IMAGE, AUDIO TRACKS & SELECT FORMAT -->
            <!-- ====================================================================== -->
            <StackPanel x:Name="Step1Panel">
                <!-- Optical Disc Format Selector -->
                <controls:SectionCard Header="Step 1A: Select Optical Disc Media" IconKind="Disc" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CD-R Tile -->
                        <RadioButton Grid.Column="0" GroupName="DiscFormatGroup"
                                     IsChecked="{Binding IsCd, Mode=OneWay}"
                                     Click="SelectCdFormat">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <iconPacks:PackIconLucide Kind="Disc3" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" />
                                                <TextBlock Text="CD-R" FontWeight="Bold" FontSize="15" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Standard 80 min (700 MB)" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="Printable area: 24.5 – 56.8 mm" Style="{StaticResource CompactHint}" Margin="0,4,0,0" />
                                            <Border Background="{DynamicResource PrimarySubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                <TextBlock Text="Supports Audio CD + Visual Hybrid" Style="{StaticResource MicroText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- DVD-R Tile -->
                        <RadioButton Grid.Column="2" GroupName="DiscFormatGroup"
                                     IsChecked="{Binding IsDvd, Mode=OneWay}"
                                     Click="SelectDvdFormat">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <iconPacks:PackIconLucide Kind="Disc" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" />
                                                <TextBlock Text="DVD-R / DVD+R" FontWeight="Bold" FontSize="15" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Single Layer 120 mm (4.7 GB)" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="Printable area: 24.0 – 58.0 mm" Style="{StaticResource CompactHint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- BD-R Tile -->
                        <RadioButton Grid.Column="4" GroupName="DiscFormatGroup"
                                     IsChecked="{Binding IsBluRay, Mode=OneWay}"
                                     Click="SelectBdFormat">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="16"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <iconPacks:PackIconLucide Kind="DiscAlbum" Width="20" Height="20" Foreground="{DynamicResource PrimaryBrush}" />
                                                <TextBlock Text="BD-R (Blu-ray)" FontWeight="Bold" FontSize="15" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Single Layer 120 mm (25 GB)" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="Printable area: 24.0 – 58.0 mm" Style="{StaticResource CompactHint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>
                </controls:SectionCard>

                <!-- Step 1B: Audio CD Tracks (Hybrid Audio + Visual Surface) -->
                <controls:SectionCard Header="Step 1B: Attach Audio Tracks (Optional: Audio CD + Surface Visual Hybrid)" IconKind="Music" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Attach audio songs (.mp3, .flac, .wav, .m4a). The system automatically decodes to Red Book Audio standard, calculates total playback duration, and measures the remaining disc surface available for your artwork."
                                   Style="{StaticResource BodyText}" Margin="0,0,0,14" />

                        <!-- Action Bar -->
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0"
                                    Command="{Binding AddAudioFilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="+ Attach Audio Files (MP3 / FLAC / WAV)" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="32" Padding="12,0"
                                    Command="{Binding ClearAudioTracksCommand}"
                                    Visibility="{Binding HasAudioTracks, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Trash2" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Clear All Tracks" Margin="6,0,0,0" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Audio Track List Items -->
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding HasAudioTracks, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Attached Audio CD Tracks" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding AudioTracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Track Number Badge -->
                                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                                            Background="{DynamicResource Surface3Brush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TrackNumber}" FontWeight="Bold" FontSize="11"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <!-- Title & Path -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding FilePath}" Style="{StaticResource MicroText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!-- Duration & Size -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                                        <TextBlock Text="{Binding DurationFormatted}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryBrush}" />
                                                        <TextBlock Text="{Binding FileSizeFormatted}" Style="{StaticResource MicroText}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <!-- Move Up / Down -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                        <Button Style="{StaticResource GhostButton}" Padding="4"
                                                                Command="{Binding DataContext.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <iconPacks:PackIconLucide Kind="ChevronUp" Width="14" Height="14" />
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Padding="4"
                                                                Command="{Binding DataContext.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <iconPacks:PackIconLucide Kind="ChevronDown" Width="14" Height="14" />
                                                        </Button>
                                                    </StackPanel>
                                                    <!-- Delete Button -->
                                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="6" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveAudioTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Disc Surface Split Live Gauges (Audio Playing Duration vs Artwork Radial Width) -->
                        <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Live Disc Surface &amp; Playback Capacity Metrics" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                                <!-- Two KPI Metric Cards Side-by-Side -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left KPI: Audio Playing Duration -->
                                    <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}" BorderBrush="#3300bcd4"
                                            BorderThickness="1.5" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <iconPacks:PackIconLucide Kind="Volume2" Width="18" Height="18" Foreground="#00bcd4" />
                                                <TextBlock Text="Audio CD Playback Duration" FontWeight="SemiBold" FontSize="13" Foreground="#00bcd4" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding AudioTotalDurationText}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,2" />
                                            <TextBlock Text="{Binding AudioRemainingDurationText}" Style="{StaticResource CompactHint}" />
                                            <TextBlock Text="{Binding AudioUsagePercent, StringFormat='{}{0:F1}% of optical disc surface'}"
                                                       Style="{StaticResource MicroText}" Foreground="#00bcd4" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Right KPI: Available Artwork Radial Width -->
                                    <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" BorderBrush="#337c4dff"
                                            BorderThickness="1.5" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <iconPacks:PackIconLucide Kind="Maximize2" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" />
                                                <TextBlock Text="Available Artwork Surface Width" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ArtworkRadialWidthText}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,2" />
                                            <TextBlock Text="High-resolution laser burned visual graphic area" Style="{StaticResource CompactHint}" />
                                            <TextBlock Text="{Binding ArtworkUsagePercent, StringFormat='{}{0:F1}% of optical disc surface'}"
                                                       Style="{StaticResource MicroText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Visual Dual-Color Surface Allocation Bar -->
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Disc Allocation Ratio:" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding AudioSummaryText}" Style="{StaticResource MicroText}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DockPanel>
                                    <Grid Height="14">
                                        <Border CornerRadius="7" Background="{DynamicResource Surface3Brush}" />
                                        <!-- Dual Color Strip -->
                                        <Grid ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding AudioUsagePercent, StringFormat='{}{0}*'}" />
                                                <ColumnDefinition Width="{Binding ArtworkUsagePercent, StringFormat='{}{0}*'}" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Audio Zone Color (Cyan) -->
                                            <Border Grid.Column="0" Background="#00bcd4" CornerRadius="7,0,0,7" ToolTip="Audio Playback Data Area" />
                                            <!-- Artwork Zone Color (Violet Primary) -->
                                            <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="0,7,7,0" ToolTip="Surface Visual Artwork Area" />
                                        </Grid>
                                    </Grid>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="● Inner Hub to Audio End Radius" Style="{StaticResource MicroText}" Foreground="#00bcd4" />
                                        <TextBlock Text="● Artwork Surface Ring to Outer Perimeter" Style="{StaticResource MicroText}" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>

                                <!-- Capacity Warning Alert if over 80 min -->
                                <Border Background="{DynamicResource DangerSubtleBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0"
                                        Visibility="{Binding IsAudioCapacityExceeded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="TriangleAlert" Width="20" Height="20" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Audio duration exceeds standard 80-minute CD-R capacity! Please remove some tracks to enable burning."
                                                   Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:SectionCard>

                <!-- Step 1C: Artwork Image Selector -->
                <controls:SectionCard Header="Step 1C: Choose Artwork Graphic" IconKind="Image" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Drop & Browse Area -->
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="2" CornerRadius="{StaticResource RadiusCard}" Padding="32"
                                Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="ImageUp" Width="44" Height="44" HorizontalAlignment="Center"
                                                          Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="Click to Select Image File (.png, .jpg, .webp, .bmp)"
                                           FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="Supports square or rectangular graphics; transparent PNG recommended"
                                           Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Browse Image File..."
                                        Height="{StaticResource ControlHeight}" Padding="20,0" Margin="0,16,0,0"
                                        HorizontalAlignment="Center" Command="{Binding LoadImageCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Loaded Image Status Details -->
                        <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="14" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6" Background="{DynamicResource Surface3Brush}"
                                        ClipToBounds="True" Margin="0,0,16,0">
                                    <Image Source="{Binding ImagePreview}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Loaded Artwork Image" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="{Binding ImageInfoText}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Change..."
                                        Height="32" Padding="14,0" VerticalAlignment="Center"
                                        Command="{Binding LoadImageCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </controls:SectionCard>

                <!-- Next Button -->
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="Next: Position on Disc Layout ➔" Height="42" Padding="24,0"
                            Command="{Binding NextStepCommand}" />
                </DockPanel>
            </StackPanel>

            <!-- ====================================================================== -->
            <!-- STEP 2: POSITION ON DISC LAYOUT -->
            <!-- ====================================================================== -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Disc Layout Canvas Preview -->
                    <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}" Padding="16" Height="500">
                        <Grid ClipToBounds="True">
                            <!-- Visual concentric disc rings background -->
                            <!-- Physical Disc Outer Rim (120mm) -->
                            <Ellipse Width="420" Height="420" Stroke="{DynamicResource DividerBrush}" StrokeThickness="2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#0c0d10" />

                            <!-- Printable Area Outer Ring (56.8 mm radius -> 397.6 px diameter) -->
                            <Ellipse Width="398" Height="398" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                     StrokeDashArray="4 2" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- The Layer Image with user transformations -->
                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" MaxWidth="398" MaxHeight="398"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ScalePercent, Converter={StaticResource ScalePercentToFactorConverter}}"
                                                        ScaleY="{Binding ScalePercent, Converter={StaticResource ScalePercentToFactorConverter}}" />
                                        <RotateTransform Angle="{Binding RotationDeg}" />
                                        <TranslateTransform X="{Binding TranslateXMm, Converter={StaticResource MmToPixelConverter}}"
                                                            Y="{Binding TranslateYMm, Converter={StaticResource MmToPixelConverter}}" />
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>

                            <!-- Audio Playback Data Zone (Concentric Inner Ring when audio tracks attached) -->
                            <Ellipse Width="{Binding AudioZoneDiameterPx}" Height="{Binding AudioZoneDiameterPx}"
                                     Stroke="#00bcd4" StrokeThickness="2" StrokeDashArray="3 2"
                                     Fill="#3300bcd4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding HasAudioTracks, Converter={StaticResource BoolToVis}}" />

                            <!-- Non-printable Inner Clamp Mask (Hub 15mm & Inner Data boundary 24.5mm) -->
                            <Ellipse Width="171.5" Height="171.5" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1"
                                     StrokeDashArray="3 3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="105" Height="105" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                     Fill="#1a1c22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- Center Spindle Hole -->
                            <Ellipse Width="52.5" Height="52.5" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"
                                     Fill="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Canvas Badges & Overlay Legends -->
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                <TextBlock Text="{Binding FormatName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding AudioSummaryText}" Style="{StaticResource MicroText}"
                                           Foreground="#00bcd4" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding ArtworkRadialWidthText, StringFormat='Available Artwork: {0}'}"
                                               Style="{StaticResource MicroText}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="Dashed rings = Outer printable &amp; inner audio boundaries"
                                           Style="{StaticResource MicroText}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Layout & Position Controls -->
                    <StackPanel Grid.Column="2">
                        <!-- Quick Alignment -->
                        <controls:SectionCard Header="Alignment Presets" IconKind="Move" Margin="0,0,0,16">
                            <UniformGrid Columns="3">
                                <Button Style="{StaticResource SecondaryButton}" Content="Fit to Disc" Margin="2"
                                        Command="{Binding FitToDiscCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Center" Margin="2"
                                        Command="{Binding CenterImageCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Reset Angle" Margin="2"
                                        Command="{Binding ResetRotationCommand}" />
                            </UniformGrid>
                        </controls:SectionCard>

                        <!-- Transform Controls -->
                        <controls:SectionCard Header="Scale &amp; Rotation" IconKind="RotateCw" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Scale:" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ScalePercent, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"
                                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                </DockPanel>
                                <Slider Minimum="10" Maximum="300" Value="{Binding ScalePercent, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="10" IsSnapToTickEnabled="False" Margin="0,0,0,12" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Rotation Angle:" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding RotationDeg, StringFormat={}{0:F0}°}" HorizontalAlignment="Right"
                                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="360" Value="{Binding RotationDeg, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="15" Margin="0,0,0,12" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Offset X (mm):" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TranslateXMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"
                                                 Style="{StaticResource CompactTextBox}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Offset Y (mm):" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TranslateYMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"
                                                 Style="{StaticResource CompactTextBox}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </controls:SectionCard>

                        <!-- Dithering & Tone -->
                        <controls:SectionCard Header="Optical Tone &amp; Dithering" IconKind="SlidersHorizontal" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Dither Algorithm:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding DitherOptions}" SelectedItem="{Binding SelectedDither}"
                                          Margin="0,0,0,8" />
                                <TextBlock Text="Blue Noise provides ultra-smooth dye gradient on optical tracks"
                                           Style="{StaticResource MicroText}" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </controls:SectionCard>
                    </StackPanel>
                </Grid>

                <!-- Navigation Action Bar -->
                <DockPanel Margin="0,20,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}"
                            Content="⬅ Back to Step 1" Height="42" Padding="20,0"
                            Command="{Binding PrevStepCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="Next: Finalize &amp; Burn ➔" Height="42" Padding="24,0"
                            Command="{Binding NextStepCommand}" />
                </DockPanel>
            </StackPanel>

            <!-- ====================================================================== -->
            <!-- STEP 3: FINALIZE & BURN -->
            <!-- ====================================================================== -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <!-- Summary Card -->
                <controls:SectionCard Header="Step 3A: Disc Media &amp; Payload Summary" IconKind="Info" Margin="0,0,0,20">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Format" Style="{StaticResource MicroText}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding FormatName}" FontWeight="Bold" FontSize="14" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Audio CD Playback" Style="{StaticResource MicroText}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding AudioTotalDurationText}" FontWeight="Bold" FontSize="14" Foreground="#00bcd4" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Artwork Width" Style="{StaticResource MicroText}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ArtworkRadialWidthText}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Burn Status" Style="{StaticResource MicroText}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="Payload Ready" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </controls:SectionCard>

                <!-- Optical Recorder & Burn Speed -->
                <controls:SectionCard Header="Step 3B: Optical Burner &amp; Speed" IconKind="Flame" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Optical Recorder Drive:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding RefreshDevicesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="RotateCw" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding DeviceStatusText}" Style="{StaticResource HintText}" Margin="0,0,0,12" />

                        <TextBlock Text="Write Speed:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SpeedStatusText}" Style="{StaticResource HintText}" />
                    </StackPanel>
                </controls:SectionCard>

                <!-- Burn Execution & Progress -->
                <Border Style="{StaticResource DangerCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <iconPacks:PackIconLucide Kind="Flame" Width="22" Height="22" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="Burn Confirmation" Style="{StaticResource CardTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Direct hardware laser streaming will write the synthesis image onto the physical disc."
                                   Style="{StaticResource BodyText}" Foreground="{DynamicResource WarningTextBrush}" />
                        <CheckBox Content="I have inserted the blank optical disc into the burner drive"
                                  IsChecked="{Binding ConfirmBurnChecked}" Margin="0,12,0,16" />

                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Content="🔥 Start Hardware Burn"
                                    Height="{StaticResource ControlHeightLarge}" Padding="28,0"
                                    Command="{Binding StartBurnCommand}" />
                            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Cancel Burn"
                                    Height="{StaticResource ControlHeightLarge}" Padding="20,0" Margin="12,0,0,0"
                                    Command="{Binding CancelBurnCommand}"
                                    IsEnabled="{Binding IsBurning}" />
                            <!-- Export Master WAV + CUE Option -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                    Content="📦 Export Master WAV + CUE Sheet" Height="{StaticResource ControlHeightLarge}" Padding="20,0"
                                    Command="{Binding GenerateHybridMasterCommand}"
                                    Visibility="{Binding HasAudioTracks, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>

                        <!-- Progress Bar & Status -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBurning, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding BurnProgress}"
                                         Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding BurnStatusText}" Style="{StaticResource HintText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Action Bar -->
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}"
                            Content="⬅ Back to Step 2 (Positioning)" Height="42" Padding="20,0"
                            Command="{Binding PrevStepCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="Proceed to Step 4: Save Design ➔" Height="42" Padding="24,0"
                            Command="{Binding NextStepCommand}" />
                </DockPanel>
            </StackPanel>

            <!-- ====================================================================== -->
            <!-- STEP 4: SAVE DESIGN OPTION -->
            <!-- ====================================================================== -->
            <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                <controls:SectionCard Header="Save Your Disc Project for Later Burning" IconKind="Save" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Save this design project so you can reopen, adjust, and re-burn identical discs at any time."
                                   Style="{StaticResource BodyText}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Project Name:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" Text="{Binding ProjectSaveName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CompactTextBox}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="💾 Save Project (.discproj)"
                                    Height="{StaticResource ControlHeight}" Padding="20,0" Margin="12,0,0,0"
                                    Command="{Binding SaveProjectCommand}" />
                        </Grid>

                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Export Master Sector Image" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                                <TextBlock Text="You can also export the pre-calculated raw track image (ISO or WAV + CUE) to burn using standard mastering tools or verify in emulator."
                                           Style="{StaticResource HintText}" Margin="0,0,0,12" />
                                <Button Style="{StaticResource SecondaryButton}" Content="📦 Export Master Image / ISO"
                                        Height="36" Padding="18,0" HorizontalAlignment="Left"
                                        Command="{Binding ExportMasterCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:SectionCard>

                <!-- Finish Actions -->
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="CircleCheck" Width="48" Height="48" Foreground="{DynamicResource SuccessBrush}"
                                                  HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Disc Creation Completed!" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Your optical disc design is saved and ready for production." Style="{StaticResource HintText}"
                                   HorizontalAlignment="Center" Margin="0,4,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Content="✨ Start Another Disc"
                                    Height="40" Padding="20,0" Margin="0,0,10,0"
                                    Command="{Binding ResetWizardCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="🏠 Return to Home"
                                    Height="40" Padding="24,0"
                                    Command="{Binding ReturnHomeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
